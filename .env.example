# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Model routing: cheap model for single-symptom incidents, strong model for
# multi-fault incidents or after a failed verification.
# Verify IDs + cache prices with:  python -m autoheal.cli models
AUTOHEAL_CHEAP_MODEL=google/gemini-3.8-flash
AUTOHEAL_STRONG_MODEL=anthropic/claude-sonnet-5.5

# Hard spending caps in USD (enforced before every LLM call)
AUTOHEAL_MAX_TOTAL_USD=8.0
AUTOHEAL_MAX_INCIDENT_USD=0.30

# Guardrails
AUTOHEAL_MAX_STEPS=16
AUTOHEAL_MAX_MUTATIONS=8
AUTOHEAL_MAX_VERIFY=2
AUTOHEAL_MAX_GUARD_BLOCKS=3
AUTOHEAL_MAX_WAIT_TICKS=12
AUTOHEAL_MAX_AUTO_RISK=medium
AUTOHEAL_DRY_RUN=false
